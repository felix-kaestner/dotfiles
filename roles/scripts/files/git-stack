#!/usr/bin/env bash
# git-stack: push stacked branches and update PR bases
# usage: git stack <command> [options]

set -eu

DRY_RUN=false

help() {
    echo >&2 "Usage: git stack <command> [options]

Push stacked branches and update GitHub PR base branches.

Commands:
  init --base <trunk> <branch...>   Define the stack (order matters)
  push [--dry-run]                  Force-push all branches + update PR bases
  add <branch> [--at <commit>]      Add a branch to the stack (position auto-detected)
  rm, remove <branch>               Remove a branch from the stack
  ls, list                          Show current stack

Options-w>=
  -h, --help                        Show this help message and exit

Example:
  git stack init --base main feature/auth feature/api feature/ui
  git stack push"
}

if [[ $# -eq 0 || "${1:-}" =~ ^(-h|--help)$ ]]; then
    help
    exit 0
fi

die() {
    echo >&2 "git-stack: $1"
    exit 1
}

GIT_DIR="$(git rev-parse --git-dir 2>/dev/null)" || die "not a git repository"
STACK_FILE="$GIT_DIR/stack.json"

require_stack() {
    [[ -f "$STACK_FILE" ]] || die "no stack found; run 'git stack init' first"
}

read_base() {
    python3 -c "import json,sys; print(json.load(open(sys.argv[1]))['base'])" "$STACK_FILE"
}

read_branches() {
    python3 -c "import json,sys; [print(b) for b in json.load(open(sys.argv[1]))['branches']]" "$STACK_FILE"
}

write_stack() {
    local base="$1"
    shift
    python3 -c "import json,sys; json.dump({'base': sys.argv[1], 'branches': sys.argv[2:-1]}, open(sys.argv[-1],'w'), indent=2)" "$base" "$@" "$STACK_FILE"
}

cmd_init() {
    local base=""
    local branches=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
        --base)
            base="$2"
            shift 2
            ;;
        *)
            branches+=("$1")
            shift
            ;;
        esac
    done

    [[ -n "$base" ]] || die "init requires --base <trunk>"
    [[ ${#branches[@]} -gt 0 ]] || die "init requires at least one branch"

    # Verify all branches exist locally
    for b in "${branches[@]}"; do
        git rev-parse --verify "$b" >/dev/null 2>&1 || die "branch '$b' does not exist"
    done

    write_stack "$base" "${branches[@]}"
    echo "Stack initialized: ${branches[*]} (base: $base)"
}

cmd_push() {
    require_stack

    while [[ $# -gt 0 ]]; do
        case "$1" in
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        *) die "push: unknown option '$1'" ;;
        esac
    done

    local base
    base="$(read_base)"
    local branches
    mapfile -t branches < <(read_branches)

    # Force-push all branches
    echo "Pushing ${#branches[@]} branches..."
    for b in "${branches[@]}"; do
        if [[ "$DRY_RUN" == true ]]; then
            echo "  git push --force-with-lease origin $b"
        else
            if ! git push --force-with-lease origin "$b" 2>&1 | sed "s/^/  /"; then
                die "failed to push '$b'"
            fi
        fi
    done

    # Create missing PRs + update bases
    local prev="$base"
    for b in "${branches[@]}"; do
        local pr_number
        pr_number=$(gh pr list --head "$b" --state open --json number --jq '.[0].number' 2>/dev/null || true)

        if [[ -z "$pr_number" || "$pr_number" == "null" ]]; then
            if [[ "$DRY_RUN" == true ]]; then
                echo "  gh pr create --head $b --base $prev"
            else
                local title
                title=$(git log -1 --format='%s' "$b")
                local body
                body=$(git log -1 --format='%b' "$b" | sed '/^\(Signed-off-by\|Co-authored-by\|Acked-by\|Reviewed-by\|Tested-by\|Reported-by\|Suggested-by\|Helped-by\|Change-Id\|Cc\):/Id')
                local url
                url=$(gh pr create --head "$b" --base "$prev" --title "$title" --body "$body")
                echo "  ✓ Created PR ($b) base → $prev: $url"
            fi
        else
            local current_base
            current_base=$(gh pr view "$pr_number" --json baseRefName --jq '.baseRefName' 2>/dev/null || true)

            if [[ "$current_base" != "$prev" ]]; then
                if [[ "$DRY_RUN" == true ]]; then
                    echo "  gh pr edit #$pr_number ($b) --base $prev (currently: $current_base)"
                else
                    gh pr edit "$pr_number" --base "$prev" >/dev/null
                    echo "  ✓ PR #$pr_number ($b) base → $prev"
                fi
            elif [[ "$DRY_RUN" == true ]]; then
                echo "  # PR #$pr_number ($b) already correct (base: $prev)"
            fi
        fi

        prev="$b"
    done

    echo "Done."
}

cmd_add() {
    require_stack

    local branch=""
    local at=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
        --at)
            at="$2"
            shift 2
            ;;
        *)
            branch="$1"
            shift
            ;;
        esac
    done

    [[ -n "$branch" ]] || die "add requires a branch name"

    # Create the branch at the specified commit if --at is given
    if [[ -n "$at" ]]; then
        git rev-parse --verify "$at" >/dev/null 2>&1 || die "commit '$at' does not exist"
        if git rev-parse --verify "$branch" >/dev/null 2>&1; then
            die "branch '$branch' already exists"
        fi
        git branch "$branch" "$at"
        echo "Created branch '$branch' at $at"
    else
        git rev-parse --verify "$branch" >/dev/null 2>&1 || die "branch '$branch' does not exist"
    fi

    local base
    base="$(read_base)"
    local branches
    mapfile -t branches < <(read_branches)

    # Check if already in stack
    for b in "${branches[@]}"; do
        [[ "$b" != "$branch" ]] || die "'$branch' is already in the stack"
    done

    # Auto-detect position: insert after the last branch that is an ancestor
    local commit
    commit=$(git rev-parse "$branch")
    local insert_idx=0
    for i in "${!branches[@]}"; do
        if git merge-base --is-ancestor "${branches[$i]}" "$commit" 2>/dev/null; then
            insert_idx=$((i + 1))
        fi
    done

    # Insert at detected position
    local new_branches=("${branches[@]:0:$insert_idx}" "$branch" "${branches[@]:$insert_idx}")

    write_stack "$base" "${new_branches[@]}"
    echo "Added '$branch' to stack (position $((insert_idx + 1))/${#new_branches[@]})."
}

cmd_rm() {
    require_stack

    [[ $# -ge 1 ]] || die "rm requires a branch name"
    local target="$1"

    local base
    base="$(read_base)"
    local branches
    mapfile -t branches < <(read_branches)

    local new_branches=()
    local found=false
    for b in "${branches[@]}"; do
        if [[ "$b" == "$target" ]]; then
            found=true
        else
            new_branches+=("$b")
        fi
    done

    [[ "$found" == true ]] || die "'$target' not found in stack"

    write_stack "$base" "${new_branches[@]}"
    echo "Removed '$target' from stack."
}

cmd_list() {
    require_stack

    local base
    base="$(read_base)"
    local branches
    mapfile -t branches < <(read_branches)

    echo "base: $base"
    local prev="$base"
    for b in "${branches[@]}"; do
        local sha
        sha=$(git rev-parse --short "$b" 2>/dev/null || echo "???")
        echo "  $b ($sha) → base: $prev"
        prev="$b"
    done
}

# Main entry point
command="$1"
shift

case "$command" in
init) cmd_init "$@" ;;
push) cmd_push "$@" ;;
add) cmd_add "$@" ;;
rm | remove) cmd_rm "$@" ;;
ls | list) cmd_list "$@" ;;
*)
    echo >&2 "git-stack: unknown command '$command'"
    help
    exit 1
    ;;
esac
