#!/usr/bin/env python3
import argparse
import base64
import json
import sys


def decode(value):
    return base64.urlsafe_b64decode(value + "=" * (-len(value) % 4))


parser = argparse.ArgumentParser(description="Decode a JWT without verifying its signature.")
parser.add_argument("token", nargs="?", help="JWT (reads from stdin when omitted)")
parser.add_argument("--base64", action="store_true", help="force Base64 decoding of the input first")
args = parser.parse_args()

try:
    token = args.token or sys.stdin.read().strip()
    if not token:
        parser.error("JWT required as an argument or via stdin")
    if args.base64 or len(token.split(".")) != 3:
        token = decode(token).decode()

    header, payload, _ = token.split(".")
    print("Header:")
    print(json.dumps(json.loads(decode(header)), indent=2))
    print("Payload:")
    print(json.dumps(json.loads(decode(payload)), indent=2))
except (ValueError, UnicodeDecodeError, json.JSONDecodeError) as error:
    parser.error(f"invalid JWT: {error}")
