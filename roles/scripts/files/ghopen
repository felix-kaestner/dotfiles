#!/usr/bin/env bash
# ghopen: Open the GitHub Repository of the current tmux/herdr session
# usage: ghopen

help() {
    echo >&2 "Usage: $(basename "$0")

Open the GitHub Repository of the currently active tmux or herdr session

Options:
  -h, --help        Show this help message and exit

Example:
  $(basename "$0")"
}

if [[ $# -gt 0 || "$*" =~ (-h|--help) ]]; then
    help
    exit 0
fi

if [ -n "$TMUX" ]; then
    dir=$(tmux run "echo #{pane_start_path}")
elif [ -n "$HERDR_ENV" ]; then
    json=$(herdr pane current 2>/dev/null) &&
        dir=$(echo "$json" | python3 -c "import sys,json; print(json.loads(sys.stdin.read())['result']['pane']['cwd'])") ||
        dir="$PWD"
else
    dir="$PWD"
fi

cd "$dir" || exit 1

url=$(git remote get-url origin 2>/dev/null | sed -E 's#(git@|https://)([^/:]+)[:/]#https://\2/#;s#\.git$##')
if [ -z "$url" ]; then
    echo "No git repository found for the current session." >&2
    exit 1
fi

if command -v open >/dev/null 2>&1; then
    open "$url"
elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url"
else
    echo "Could not find a command to open URLs (open or xdg-open)." >&2
    exit 1
fi
