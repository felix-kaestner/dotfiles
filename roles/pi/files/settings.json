{
  "packages": [
    "npm:pi-web-access"
  ],
  "lastChangelogVersion": "1.4.0",
  "defaultProvider": "hai-proxy-openai",
  "defaultModel": "gpt-5.6-terra",
  "terminal": {
    "showTerminalProgress": true
  },
  "enableInstallTelemetry": false,
  "defaultThinkingLevel": "medium",
  "quietStartup": false,
  "theme": "light/dark",
  "extensions": [
    "+builtin:mcp",
    "+builtin:tool-search"
  ],
  "hideThinkingBlock": true,
  "tuiMode": "regular"
}
